FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Rootless Podman on this cluster has no /etc/subuid range for the current
# user, so apt's privilege-drop sandbox (which wants to run as uid 42 /
# _apt) cannot map that uid and fails. Disabling the sandbox is required.
RUN echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/99no-sandbox && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        git \
        bash \
        tar \
        xz-utils \
        clang \
        lld \
        libc6-dev \
        && \
    rm -rf /var/lib/apt/lists/*

# clang/lld/libc6-dev: `mojo build` links a native binary and needs a
# system C toolchain + linker. LLVM (clang/lld) is used here in preference
# to gcc/binutils, per project preference.

ENV PIXI_HOME=/opt/pixi
ENV PATH="$PIXI_HOME/bin:$PATH"

# Same subuid constraint as above: the pixi installer's tar extraction
# preserves ownership by default, which fails without a uid/gid mapping
# range.
ENV TAR_OPTIONS=--no-same-owner
RUN curl -fsSL https://pixi.sh/install.sh | bash

# Image-baked infra tools only (the repo's top-level pixi.toml default
# environment: git, jq, vim, nano, ttyd, python). The `https` feature
# environment (caddy, openssl, qrcode/pillow for the QR code) is NOT
# installed here -- those run on the HOST via container/terminal-wrap.sh,
# never inside the container.
#
# The Mojo/MAX toolchain itself is also NOT baked in here -- it's installed
# into /work/app at container startup from the seeded container/app, so
# students can edit dependencies without a rebuild (see entrypoint.sh).
COPY pixi.toml pixi.lock /opt/app/
WORKDIR /opt/app
RUN pixi install --locked

# Nano syntax highlighting: the conda-forge nano package ships its own
# */*.nanorc syntax defs under share/nano/, but nothing enables them
# without this -- there's no system /etc/nanorc by default.
RUN echo 'include "/opt/app/.pixi/envs/default/share/nano/*.nanorc"' > /etc/nanorc

# Vim indentation defaults: conda-forge's vim looks for its system vimrc
# at $VIM/vimrc, which for this package resolves to
# .../share/vim/vimrc -- there's no system vimrc there by default, so
# `tabstop` etc. were falling back to vim's compiled-in default of 8/tabs.
RUN cat > /opt/app/.pixi/envs/default/share/vim/vimrc <<'VIMRCEOF'
set tabstop=4      " Number of visual spaces a Tab character takes up
set shiftwidth=4   " Number of spaces used for each step of (auto)indent
set expandtab      " Converts tabs to spaces
VIMRCEOF

# Vim's own bundled Mojo syntax/indent/ftplugin files (vim92/{syntax,
# ftplugin,indent}/mojo.vim) are last updated 2023-09 and don't know any
# Mojo-specific keyword ('fn', 'struct', 'trait', 'alias', 'owned',
# 'borrowed', 'inout', 'raises') -- they're really just Python's
# highlighting relabeled. Replace them with Modular's own actively
# maintained plugin (github.com/modular/mojo.vim, Apache-2.0), pinned to
# a commit for reproducibility.
ARG MOJO_VIM_COMMIT=e5d7af4c1896f903694aed79b9e3be14d75eba17
RUN VIM92=/opt/app/.pixi/envs/default/share/vim/vim92 && \
    mkdir -p "$VIM92/ftdetect" && \
    for f in syntax/mojo.vim ftplugin/mojo.vim indent/mojo.vim autoload/mojo.vim ftdetect/mojo.vim; do \
        curl -fsSL "https://raw.githubusercontent.com/modular/mojo.vim/${MOJO_VIM_COMMIT}/${f}" -o "$VIM92/$f"; \
    done

# Even Modular's own plugin above doesn't highlight Mojo's actual
# standard-library type names as types -- its "builtin" keyword list is
# inherited straight from Python's (str, int, float, dict, ...), not
# Mojo's capitalized ones (Int, String, SIMD, DType, ...). Layered on top
# via vim's "after/syntax" mechanism (sourced after the main syntax file,
# specifically for this kind of augmentation) rather than editing the
# vendored file directly, so re-pinning MOJO_VIM_COMMIT above doesn't
# require re-merging this in.
RUN mkdir -p /opt/app/.pixi/envs/default/share/vim/vimfiles/after/syntax && \
    cat > /opt/app/.pixi/envs/default/share/vim/vimfiles/after/syntax/mojo.vim <<'MOJOTYPESEOF'
" Mojo's own standard-library type names, highlighted as types (neither
" vim's bundled mojo.vim nor modular/mojo.vim do this -- see Containerfile).
syn keyword mojoType Int Int8 Int16 Int32 Int64 Int128 Int256
syn keyword mojoType UInt UInt8 UInt16 UInt32 UInt64 UInt128 UInt256
syn keyword mojoType Float16 Float32 Float64 BFloat16
syn keyword mojoType Bool Byte
syn keyword mojoType String StringLiteral StringRef StringSlice
syn keyword mojoType List Dict Set Tuple Optional Variant ListLiteral
syn keyword mojoType SIMD DType Scalar
syn keyword mojoType Error NoneType AnyType
syn keyword mojoType Reference UnsafePointer Pointer Span Slice
syn keyword mojoType Coroutine CoroutineContext PythonObject Atomic
hi def link mojoType Type

" 'comptime' and 'capturing' postdate modular/mojo.vim's last update
" (2023-02) but show up in Modular's own, more recently updated TextMate
" grammar (github.com/modular/mojo-syntax) -- borrowed from there.
syn keyword mojoStatement comptime capturing
MOJOTYPESEOF

# Welcome-banner text: a colorized "hhmi | janelia" wordmark, matching
# https://www.janelia.org/sites/default/files/Design/HHMI_Janelia_Logo_Black_Background.png
# for a dark terminal background. Rendered as real ANSI-colored text, not
# pixel/block art -- the source logo is itself mostly small wordmark
# text, which blurs into illegibility once rasterized to a block-art
# resolution any terminal can actually display.
COPY container/motd.ans /opt/app/motd.ans

# Classroom cosmetics: Ubuntu's default /etc/bash.bashrc (sourced by every
# interactive shell, login or not) unconditionally sets PS1 to \u@\h:\w
# further up in this same file -- appending our override here, after it,
# is the only way to reliably win rather than just being clobbered.
# Also enables colorized `ls`/`grep`, off by default since a student's
# $HOME has no .bashrc of its own to turn it on (see entrypoint.sh), and
# prints the welcome banner once per interactive shell.
RUN cat >> /etc/bash.bashrc <<'RCEOF'

# Janelia Mojo Sandbox classroom cosmetics -- "student" in the same
# teal-to-green gradient as the welcome banner's "hhmi", "@janelia" in
# bold white matching the banner's "janelia". \[...\] markers tell bash
# the enclosed escape codes are zero-width, so line-wrapping/cursor math
# doesn't get thrown off by them.
PS1='\[\033[1;38;2;5;141;150m\]s\[\033[1;38;2;18;148;137m\]t\[\033[1;38;2;31;154;124m\]u\[\033[1;38;2;44;160;111m\]d\[\033[1;38;2;56;167;98m\]e\[\033[1;38;2;69;174;85m\]n\[\033[1;38;2;82;180;72m\]t\[\033[0m\]\[\033[1;38;2;255;255;255m\]@janelia\[\033[0m\]:\w\$ '
eval "$(dircolors -b 2>/dev/null)"
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias vi='vim'
[ -t 1 ] && cat /opt/app/motd.ans
RCEOF

ENV PIXI_ENV=/opt/app/.pixi/envs/default
ENV PATH="$PIXI_ENV/bin:$PATH"

COPY container/app /opt/app/seed/app
COPY container/entrypoint.sh /opt/app/entrypoint.sh
RUN chmod +x /opt/app/entrypoint.sh

RUN chmod -R a+rX /opt/app/.pixi /opt/pixi /opt/app/seed

EXPOSE 7681

ENTRYPOINT ["/opt/app/entrypoint.sh"]
CMD ["bash"]
